# vim: ft=gitconfig

# --- Authentication and Identity ---
[user]
  useConfigOnly = true # Prevents git from guessing user identity

# --- Git Core Configuration and Behavior ---
[core]
  autocrlf = false # Defense-in-depth; the config.d/unix|windows includes own the effective per-OS value

# --- Git Housekeeping and Maintenance ---
# Keep Standardized
[init]
  defaultBranch = main # Default branch name for new repositories

# Keep Git Clean and Organized
[branch]
  autoSetupRebase = always # Automatically set up rebase for new branches

[pull]
  rebase = true # Rebase preference when fast-forward-only is explicitly overridden
  ff = only # Plain pull refuses divergent history; use --rebase deliberately

# Keep Git Consistent (1=1 mapping for upstream refs)
[push]
  autoSetupRemote = true # Auto set remote as upstream for current branch
  followTags = true # Include eligible reachable annotated tags
  useForceIfIncludes = true # Make --force-with-lease also require local awareness of remote tip

[fetch]
  prune = true # Remove remote-tracking branches that no longer exist on remote
  pruneTags = false # Tags share a namespace; prune only with explicit --prune-tags
  all = true # Update all available remotes, unless --no-all or explicit remote

# --- Quality of Life Improvements ---
# Inspection and Comparison
[column]
  ui = auto # Show list output (branch/tag/status) in columns on a terminal

[branch]
  sort = -committerdate # Sort branches by committer date

[tag]
  sort = version:refname # Sort tags by version

[pretty]
  compact = %C(auto)%m% h%d% s ·%C(italic)% ar by% aN%C(auto)
  truncated = %C(auto)%m%h%<(40,trunc)% s·%C(italic)%<(14,trunc)% ar by%<(8,trunc)% aN%C(auto) # 80-col budget for git-glance
  compare = %C(auto)%m% h %C(italic)^%p%C(auto)%d% s ·%C(italic)% ar by% aN%C(auto)
  audit = %C(auto)%m% h%d% s ·%C(italic) at% ad by [%an](%ae)%C(auto)

[format]
  pretty = compact

[log]
  decorate = short
  date = iso-strict

# Git's yellow hashes and tags fade on light themes
[color "diff"]
  commit = blue
[color "decorate"]
  tag = blue bold

[core]
  pager = "if command -v delta >/dev/null; then delta; else less; fi"

[delta]
  syntax-theme = ansi # Terminal palette colors follow the terminal's light/dark theme
  side-by-side = true
  line-numbers-left-format = ""
  line-numbers-right-format = "│{nm:<2}┊{np:>2}│"
  line-numbers-minus-style = red # Palette colors instead of fixed grays and dark tones
  line-numbers-plus-style = green
  line-numbers-zero-style = normal

[interactive]
  diffFilter = "if command -v delta >/dev/null; then delta --color-only; else cat; fi"

[diff]
  algorithm = histogram # Use histogram diff algorithm for clearer diffs
  colorMoved = plain # Highlight any moved lines in diffs
  mnemonicPrefix = true # Use i/(index) w/(working dir) and c/(commit) prefixes
  renames = true # Detect if files have been renamed

[commit]
  verbose = true # Show diff of changes in commit messages

[merge]
  conflictStyle = zdiff3 # Add marker with content before either of the changes
  autoStash = true # Auto stash before merging and auto apply after

[grep]
  lineNumber = true # Prefix the line number to matching lines
  heading = true # Show filename above file matches instead of at each line
  break = true # Print an empty line between matches from different files
  patternType = perl # Use Perl-compatible regular expressions for patterns

# Ease of Use
[help]
  autoCorrect = prompt # Show suggestion and prompt for confirmation on typos

[rerere]
  enabled = true # Record before and after states of rebase conflicts
  autoUpdate = true # Automatically re-apply the recorded resolutions

[rebase]
  autoSquash = true # Auto squash commits with squash! fixup! or amend! prefix
  autoStash = true # Auto stash before rebasing and auto apply after
  updateRefs = true # Auto force-update any branches pointed to rebased commits

# --- URL Shorthands ---
[url "https://github.com/"]
  insteadOf = gh:

# --- GitHub Authentication ---
# gh's token handles https reads and pushes; without gh, git falls back to prompting
[credential "https://github.com"]
  helper = # Reset inherited helpers (e.g. Homebrew's system osxkeychain) for GitHub
  helper = !gh auth git-credential

# --- Git Aliases and Shortcuts ---
[alias]
  # Clone into ~/code/<owner>/<repo>; accepts gh:, https, ssh, or owner/repo forms
  clone-smart = "!f() { \
    if [ \"$#\" -ne 1 ]; then printf 'usage: git clone-smart <owner/repo-or-github-url>\\n' >&2; return 1; fi; \
    repo=\"$1\"; \
    repo=\"${repo#gh:}\"; \
    repo=\"${repo#https://github.com/}\"; \
    repo=\"${repo#git@github.com:}\"; \
    repo=\"${repo%.git}\"; \
    owner=\"${repo%%/*}\"; \
    name=\"${repo##*/}\"; \
    if [ \"$repo\" != \"$owner/$name\" ]; then printf 'error: expected owner/repo\\n' >&2; return 1; fi; \
    case \"$owner/$name\" in -*|/*|./*|../*|*/|*/..|*/.) printf 'error: invalid repository name\\n' >&2; return 1 ;; esac; \
    dest=\"$HOME/code/$owner/$name\"; \
    if command -v gh >/dev/null 2>&1; then \
      gh repo clone \"$repo\" \"$dest\"; \
    else \
      git clone \"https://github.com/$repo.git\" \"$dest\"; \
    fi; \
  }; f"

# --- External Configuration Settings ---
# OS-specific configurations
[includeIf "gitdir/i:*:/"] # Include for Windows git directories
  path = config.d/windows

[includeIf "gitdir/i:/"] # Include for Unix-like git directories
  path = config.d/unix

# Context-specific configurations
[include]
  path = config.d/personal # Should only exist on personal machine
  path = config.d/work # Should only exist on work machine

# Local overrides
[include]
  path = config.d/local
