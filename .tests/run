#!/bin/sh
# Every isolated check: no provisioning, network, or workspace applications.
# Runs from anywhere; checks whose tools are missing are reported as skipped.
set -u
# Deterministic permissions: zsh refuses group-writable completion directories.
umask 022
repo=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P) || exit 1
cd "$repo" || exit 1
failures=0
missing=

check() {
  label=$1
  shift
  if output=$("$@" 2>&1); then
    printf 'ok    %s\n' "$label"
    printf '%s\n' "$output" | sed -n 's/^SKIP: /      skip: /p'
  else
    failures=$((failures + 1))
    printf 'FAIL  %s\n' "$label"
    printf '%s\n' "$output" | tail -n 20 | sed 's/^/      /'
  fi
}

# Runs a check only when every listed tool (space-separated) is installed.
with() {
  tools=$1 absent=
  shift
  for tool in $tools; do
    command -v "$tool" >/dev/null 2>&1 || absent="$absent $tool"
  done
  if [ -z "$absent" ]; then
    check "$@"
    return
  fi
  for tool in $absent; do
    case " $missing " in
      *" $tool "*) ;;
      *) missing="$missing $tool" ;;
    esac
  done
}

check 'installer syntax' sh -c 'sh -n install.sh && sh -n get.sh'
with shellcheck 'shellcheck' shellcheck install.sh get.sh zsh/homebrew.sh zsh/xdg.sh .tests/run .tests/install.sh .tests/git.sh .tests/opencode.sh
# shellcheck disable=SC2016 # zsh, not sh, expands the loop
with zsh 'zsh syntax' zsh -fc 'for f in zsh/.zshenv zsh/.zprofile zsh/.zshrc zsh/*.sh zsh/functions/* zsh/bin/*; do zsh -n "$f" || exit 1; done'
with git 'git config' git config --file git/config --list
with ghostty 'ghostty config' ghostty +validate-config --config-file=ghostty/config.ghostty
with biome 'opencode config' biome lint opencode/opencode.jsonc opencode/cli.json
with 'opencode python3' 'opencode instructions' sh .tests/opencode.sh
# Both package sets parse, and the workstation keeps every essential.
# shellcheck disable=SC2016 # the inner shell expands these
with brew 'brewfile' sh -c 'export HOMEBREW_NO_AUTO_UPDATE=1; full=$(brew bundle list --file=homebrew/Brewfile --all) && core=$(brew bundle list --file=homebrew/core.Brewfile --all) || exit 1; for entry in $core; do printf "%s\n" "$full" | grep -qxF "$entry" || { printf "core entry missing from the Brewfile: %s\n" "$entry"; exit 1; }; done'
# Homebrew strips npm's variables, so homebrew/npmrc alone must yield the cache.
# shellcheck disable=SC2016 # the inner shell expands these
with npm 'npm global config' sh -c 'h=$(mktemp -d) || exit 1; c=$(env -i HOME="$h" PATH="$PATH" npm config get cache --globalconfig homebrew/npmrc --userconfig /dev/null); rm -rf "$h"; [ "$c" = "$h/.cache/npm" ] || { printf "cache resolved to %s\n" "$c"; exit 1; }'
with 'zsh git' 'lifecycle' sh .tests/install.sh
with git 'git helpers' sh .tests/git.sh
with 'zsh git' 'zsh helpers' sh .tests/zsh.sh
with zsh 'line editor' zsh -f .tests/zle.zsh
with zsh 'workspace' zsh -f .tests/workspace.zsh
with 'zsh tmux' 'tmux' zsh -f .tests/tmux.zsh
with 'nvim git' 'nvim commands' nvim --headless -u NONE -l .tests/nvim.lua
with nvim 'file tree' nvim --headless -u NONE -i NONE -l .tests/tree.lua

if [ -n "$missing" ]; then
  printf 'skipped (missing):%s\n' "$missing"
fi
[ "$failures" -eq 0 ]
