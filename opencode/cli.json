{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "system"
  },
  "keybinds": {
    "app.exit": "ctrl+c,<leader>q"
  },
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true
}
