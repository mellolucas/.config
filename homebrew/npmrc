# npm's global config for Homebrew's Node; the installer links it into
# $(brew --prefix)/etc/npmrc. Homebrew hides NPM_CONFIG_CACHE from the npm it
# runs for Brewfile entries and gives a cache only to its installs, so its
# listings and update checks would keep theirs in ~/.npm. Shells still set the
# variable, and it wins over this file.
cache=${HOME}/.cache/npm
