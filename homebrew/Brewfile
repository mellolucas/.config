# The workstation: GUI apps, dev containers, and language servers, then
# core.Brewfile's essentials and local.Brewfile. Projects bring their own
# runtimes and tools in their dev containers, or through local.Brewfile.
# Casks need a pinned checksum, as core.Brewfile says for the lean set too
cask_args require_sha: true

brew "mas" if OS.mac? && system("defaults read MobileMeAccounts Accounts >/dev/null 2>&1")

cask "ghostty" if OS.mac?

# Dev containers (devshell): the Dev Containers CLI; on macOS, Colima runs
# Docker's engine in a VM, with Docker's CLI, its compose and buildx, and the
# Keychain for registry logins. On Linux, Docker or Podman comes from the system.
brew "devcontainer"
brew "colima" if OS.mac?
brew "docker" if OS.mac?
brew "docker-compose" if OS.mac?
brew "docker-buildx" if OS.mac?
brew "docker-credential-helper" if OS.mac?

brew "lua-language-server"
brew "biome"
brew "yaml-language-server"
brew "bash-language-server"
brew "shellcheck" # bash-language-server's linter; .tests/run lints with it too
brew "typescript-language-server"
brew "basedpyright"
# Runs the language servers above, and local.Brewfile's npm entries
brew "node"

cask "obsidian" if OS.mac?

core_brewfile = File.expand_path("core.Brewfile", __dir__)
instance_eval(File.read(core_brewfile), core_brewfile)
