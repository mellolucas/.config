# The workstation: GUI apps, language servers, runtimes, and the other agents,
# then core.Brewfile's essentials and local.Brewfile.
brew "mas" if OS.mac? && system("defaults read MobileMeAccounts Accounts >/dev/null 2>&1")

cask "ghostty" if OS.mac?
brew "container" if OS.mac? && Hardware::CPU.arm? && MacOS.version >= :tahoe

brew "lua-language-server"
brew "biome"
brew "yaml-language-server"
brew "bash-language-server"
brew "shellcheck" # bash-language-server's linter; .tests/run lints with it too
brew "typescript-language-server"
brew "basedpyright"
brew "go"
brew "gopls"

brew "node"
brew "bun"
brew "python"

cask "claude-code" if OS.mac?
# Their casks are unnotarized, so macOS blocks them; npm installs are not quarantined
npm "@github/copilot"
npm "@openai/codex"

cask "obsidian" if OS.mac?

core_brewfile = File.expand_path("core.Brewfile", __dir__)
instance_eval(File.read(core_brewfile), core_brewfile)
