# Optional machine/project tools. Copy to local.Brewfile and enable what you use.
# Editor tools, Node, and OpenCode are shared; projects with a dev container get
# their runtimes and tools there.

# Coding agents beside OpenCode, for the subscriptions you have. Each reads the
# shared agents/instructions.md, linked once it's installed. Copilot CLI updates
# itself unless greedy, which leaves its updates to dotfiles update.
# cask "claude-code" if OS.mac?
# cask "copilot-cli", greedy: true if OS.mac?
# cask "codex" if OS.mac?
# npm "@github/copilot" unless OS.mac?
# npm "@openai/codex" unless OS.mac?
# Copilot outside the terminal (automations, Projects, computer use), sharing
# Copilot CLI's ~/.copilot; it updates itself
# cask "github-copilot-app" if OS.mac?
# The other agents' desktop apps: they update themselves, and may keep files in
# ~/.claude and ~/.codex rather than the agents' XDG homes
# cask "claude" if OS.mac?
# cask "chatgpt" if OS.mac?
# Alternative workspace agents (workspace --agent 'kiro-cli chat')
# cask "kiro-cli" if OS.mac?

# Runtimes for projects without a dev container; zsh/xdg.sh keeps Go's files in
# the XDG homes
# brew "go"
# brew "gopls"
# brew "bun"
# brew "python"
# Other tools published on npm
# npm "@scope/tool"

# Cloud and infrastructure projects. A tap outside Homebrew's own loads only
# what it's trusted for, here one formula
# brew "awscli"
# tap "hashicorp/tap", trusted: { formulae: ["terraform"] }
# brew "hashicorp/tap/terraform"

# A cask without a pinned checksum, its vendor serving the latest build, taken
# knowingly: macOS still checks its signature when it first opens
# cask "google-chrome", args: { require_sha: false } if OS.mac?

# Apple's container runtime, a VM per container (dev containers use Colima)
# brew "container" if OS.mac? && Hardware::CPU.arm? && MacOS.version >= :tahoe

# Personal applications
# cask "discord" if OS.mac?
# cask "steam" if OS.mac?
# cask "battle-net" if OS.mac?

# App Store apps, for those sold only there or needing its build (bought there,
# iCloud sync), on a Mac signed in to an Apple account, where the Brewfile
# installs mas. mas runs sudo to install them, so on an account that isn't an
# administrator, list their ids in HOMEBREW_BUNDLE_MAS_SKIP or leave them out;
# `mas search NAME` finds an app's id. Apps on both stay casks, updated on your
# schedule.
# mas "Xcode", id: 497799835
