# Optional machine/project tools. Copy to local.Brewfile and enable what you use.
# Editor tools, Go, Node, Bun, Python, OpenCode, Claude Code, Copilot CLI,
# Codex, and the GitHub Copilot app are shared.

# Alternative workspace agents (workspace --agent 'kiro-cli chat')
# cask "kiro-cli" if OS.mac?
# Other tools published on npm
# npm "@scope/tool"

# Cloud and infrastructure projects
# brew "awscli"
# tap "hashicorp/tap"
# brew "hashicorp/tap/terraform"

# Apple's container runtime, a VM per container (dev containers use Colima)
# brew "container" if OS.mac? && Hardware::CPU.arm? && MacOS.version >= :tahoe

# Personal applications
# cask "discord" if OS.mac?
# cask "steam" if OS.mac?
# cask "battle-net" if OS.mac?

# App Store apps, for those sold only there or needing its build (bought there,
# iCloud sync), on a Mac signed in to an Apple account, where the Brewfile
# installs mas. mas runs sudo to install them, so on an account that isn't an
# administrator, list their ids in HOMEBREW_BUNDLE_MAS_SKIP or leave them out;
# `mas search NAME` finds an app's id. Apps on both stay casks, updated on your
# schedule.
# mas "Xcode", id: 497799835

# The other agents' desktop apps: they update themselves, and may keep files in
# ~/.claude and ~/.codex rather than the agents' XDG homes
# cask "claude" if OS.mac?
# cask "chatgpt" if OS.mac?
