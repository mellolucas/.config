theme = dark:Catppuccin Mocha,light:Catppuccin Latte

window-save-state = always
auto-update = off

# A command of 10 s or more that finishes in a pane you aren't in notifies and
# rings the bell, which marks the pane with a border besides the default dock
# bounce and title bell. Agents send their own notifications
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 10s
bell-features = border

# Option types characters with either key (ç, é), as in every Mac app; on US
# layouts Ghostty would make it Alt. The word keys stay: Ghostty's own
# Option+arrows jump words, and Option+Backspace deletes one
macos-option-as-alt = false
keybind = alt+backspace=text:\x1b\x7f

# Ghostty's own Mac keys run panes, tabs, find, and scrollback. Two pass the
# key on when they can't act: Cmd+Option+arrows at a pane's edge reach
# Neovim, which moves between its windows, and Cmd+C with nothing selected
# reaches the program, so Neovim copies its own selection
keybind = performable:super+alt+arrow_left=goto_split:left
keybind = performable:super+alt+arrow_down=goto_split:down
keybind = performable:super+alt+arrow_up=goto_split:up
keybind = performable:super+alt+arrow_right=goto_split:right
keybind = performable:super+c=copy_to_clipboard:mixed
