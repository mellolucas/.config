theme = dark:Catppuccin Mocha,light:Catppuccin Latte

window-save-state = always
auto-update = off

# Left Option sends Alt; right Option retains native macOS character input.
macos-option-as-alt = left

config-file = vim.ghostty

# Cmd+C copies the terminal's selection; with none it reaches the program, so
# Neovim copies its own
keybind = performable:super+c=copy_to_clipboard:mixed
