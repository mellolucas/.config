# Splits: Option chords work in any program, no leader or mode needed.
# performable: navigation falls through to the app (nvim window nav) when no
# split exists in that direction.
keybind = performable:alt+h=goto_split:left
keybind = performable:alt+j=goto_split:down
keybind = performable:alt+k=goto_split:up
keybind = performable:alt+l=goto_split:right
keybind = alt+s=new_split:down
keybind = alt+v=new_split:right
keybind = alt+shift+h=resize_split:left,10
keybind = alt+shift+j=resize_split:down,10
keybind = alt+shift+k=resize_split:up,10
keybind = alt+shift+l=resize_split:right,10
keybind = alt+equal=equalize_splits
keybind = alt+z=toggle_split_zoom
keybind = alt+w=close_surface

# Browse mode: scrollback, search, copy.
keybind = alt+b=activate_key_table:browse
keybind = browse/k=scroll_page_lines:-1
keybind = browse/j=scroll_page_lines:1
keybind = browse/arrow_up=scroll_page_lines:-1
keybind = browse/arrow_down=scroll_page_lines:1
keybind = browse/ctrl+u=scroll_page_fractional:-0.5
keybind = browse/ctrl+d=scroll_page_fractional:0.5
keybind = browse/ctrl+b=scroll_page_up
keybind = browse/ctrl+f=scroll_page_down
keybind = browse/g>g=scroll_to_top
keybind = browse/shift+g=scroll_to_bottom
keybind = browse/super+arrow_up=jump_to_prompt:-1
keybind = browse/super+arrow_down=jump_to_prompt:1
keybind = browse/slash=start_search
keybind = browse/n=navigate_search:next
keybind = browse/shift+n=navigate_search:previous
keybind = browse/y=copy_to_clipboard
keybind = browse/super+c=copy_to_clipboard
keybind = browse/shift+semicolon=toggle_command_palette
keybind = browse/escape=deactivate_key_table
keybind = browse/q=deactivate_key_table
keybind = browse/i=deactivate_key_table
keybind = browse/alt+b=deactivate_key_table
# Chords acting on this pane keep their meaning while browsing; catch_all would
# swallow them. Moving and splitting stay off: browse mode belongs to the pane,
# which would keep ignoring typing after focus left it.
keybind = browse/alt+shift+h=resize_split:left,10
keybind = browse/alt+shift+j=resize_split:down,10
keybind = browse/alt+shift+k=resize_split:up,10
keybind = browse/alt+shift+l=resize_split:right,10
keybind = browse/alt+equal=equalize_splits
keybind = browse/alt+z=toggle_split_zoom
keybind = browse/alt+w=close_surface
keybind = browse/catch_all=ignore
