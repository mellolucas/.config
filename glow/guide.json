{
  "document": { "margin": 1 },
  "heading": { "bold": true, "block_suffix": "\n" },
  "h1": { "color": "4", "bold": true },
  "h2": { "color": "4", "bold": true },
  "h3": { "bold": true },
  "strong": { "color": "5", "bold": true },
  "emph": { "italic": true },
  "code": { "color": "6" },
  "item": { "block_prefix": "- " },
  "list": { "level_indent": 2 },
  "link_text": { "underline": true },
  "link": { "color": "4" },
  "table": { "center_separator": "│", "column_separator": "│", "row_separator": " " }
}
