# Local machine overrides and setup backups for this dotfiles repo only
**/work
**/personal

**/local
**/local.*
**/*.local
**/*.local.*

**/backup
**/backup.*
**/*.backup
**/*.backup.*

!**/*.example

# opencode runtime-generated files (plugin deps); never tracked
opencode/.gitignore
opencode/package.json
opencode/package-lock.json
opencode/bun.lock
opencode/node_modules/

# Homebrew-generated third-party tap trust store; never tracked
homebrew/trust.json*

# opencode session artifacts (plans, scratch); never tracked
/.opencode/

# Agent config domains contain templates only; runtime homes stay outside Git.
/claude/*
!/claude/settings.json.example
/codex/*
!/codex/config.toml.example
/copilot/*
!/copilot/settings.json.example
