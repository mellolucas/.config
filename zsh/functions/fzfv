# vim: ft=zsh

emulate -L zsh

if (( ${argv[(I)(-h|--help)]} )); then
  print -r -- 'usage: fzfv [FZF_OPTIONS...]'
  print -r -- 'Pick a file below here, each previewed; Enter opens it in your editor, in a'
  print -r -- "workspace in its editor. fzf's options pass through (fzf --help lists them)."
  return 0
fi

command -v fzf >/dev/null 2>&1 || {
  print -u2 -- "fzfv: fzf not found"
  return 1
}

local file_preview='command -v bat >/dev/null && bat --color=always --wrap=never --style=numbers --line-range=:500 -- {} || cat -- {}'
local preview=$file_preview

if command -v glow >/dev/null 2>&1; then
  local md_preview='glow --style "${XDG_CONFIG_HOME:-$HOME/.config}/glow/theme.json" --width 0 -- {} | sed "s/ *\$//"'
  preview="case {} in *.[mM][dD]) $md_preview;; *) $file_preview;; esac"
fi

# Enter runs v's command (zsh/bin/edit) on the pick; fzf quotes {} for its shell
fzf --bind 'enter:become(edit -- {})' --preview "$preview" --preview-window=wrap-word "$@"
