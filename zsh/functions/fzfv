# vim: ft=zsh

emulate -L zsh

command -v fzf >/dev/null 2>&1 || {
  print -u2 -- "fzfv: fzf not found"
  return 1
}

local -a editor=("${(@Q)${(z)EDITOR}}")
[[ -n $editor[1] ]] || { print -u2 'fzfv: EDITOR must name a command'; return 1 }

local file_preview='command -v bat >/dev/null && bat --color=always --wrap=never --style=numbers --line-range=:500 -- {} || cat -- {}'
local preview=$file_preview

if command -v glow >/dev/null 2>&1; then
  local md_preview='glow --style "${XDG_CONFIG_HOME:-$HOME/.config}/glow/theme.json" --width 0 -- {}'
  preview="case {} in *.[mM][dD]) $md_preview;; *) $file_preview;; esac"
fi

# fzf executes a shell string; quote every literal editor token before joining.
fzf --bind "enter:become(${(j: :)${(@q)editor}} -- {})" --preview "$preview" --preview-window=wrap "$@"
