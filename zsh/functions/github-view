# vim: ft=zsh

emulate -L zsh
setopt extended_glob

local remote=0
[[ $1 == --remote ]] && { remote=1; shift; }

local target=${${1:-$PWD}:A}
[[ -e $target ]] || {
  print -u2 -- "github-view: no such path: ${1:-$PWD}"
  return 1
}

local dir=$target
[[ -d $dir ]] || dir=${dir:h}

# aliases don't reach function bodies: pass the glow theme explicitly
local -a style=(--style "${XDG_CONFIG_HOME:-$HOME/.config}/glow/theme.json")

local root
git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
  root=${$(git -C "$dir" rev-parse --show-toplevel):A}

if (( remote )); then
  # ref: current branch, short commit when detached, empty when unborn
  local ref
  if [[ -n $root ]] && git -C "$dir" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    ref=$(git -C "$dir" symbolic-ref --short -q HEAD) ||
      ref=$(git -C "$dir" rev-parse --short HEAD)
  fi

  # owner/repo from the ~/code/<owner>/<repo> path convention, for when gh
  # cannot derive them from the remote of an enclosing repo
  local a b
  [[ $target == */code/* ]] && IFS=/ read -r a b _ <<< "${target#*/code/}"

  # 1. Primary: gh fetches the raw README at the resolved ref; authenticated,
  #    so private repos render. Endpoints: remote-derived owner/repo, then the
  #    path convention; diagnostics surface only if nothing below recovers
  local gh_err
  if command -v gh >/dev/null 2>&1; then
    local -a endpoints fields
    [[ -n $ref ]] && fields+=(-f "ref=$ref")
    [[ -n $root ]] && endpoints+=('repos/{owner}/{repo}/readme')
    [[ -n $a ]] && endpoints+=("repos/$a${b:+/$b}/readme")
    local endpoint md
    for endpoint in "${endpoints[@]}"; do
      if md=$(cd -q "${root:-$dir}" && gh api "$endpoint" --method GET "${fields[@]}" \
            -H 'Accept: application/vnd.github.raw+json' 2>&1); then
        if command -v glow >/dev/null 2>&1; then
          print -r -- "$md" | glow "${style[@]}" -p
        elif command -v bat >/dev/null 2>&1; then
          print -r -- "$md" | bat --language md
        else
          print -r -- "$md" | less
        fi
        return $?
      fi
      gh_err=$md
    done
  fi

  # 2. Fallback: glow fetches the README itself at the /code/-derived
  #    location: the raw URL at the resolved ref (only finds a literal
  #    README.md), or the repo URL (default branch) when no ref or repo name
  #    resolved
  if command -v glow >/dev/null 2>&1 && [[ -n $a ]]; then
    # Encode each URL component bytewise, including slashes in branch names.
    local LC_ALL=C
    unsetopt multibyte
    local part byte encoded escaped
    local -a url_parts
    for part in "$a" "$b" "$ref"; do
      encoded=
      for byte in "${(@s::)part}"; do
        [[ -n $byte ]] || continue
        if [[ $byte == [a-zA-Z0-9.~_-] ]]; then
          encoded+=$byte
        else
          printf -v escaped '%%%02X' "'$byte"
          encoded+=$escaped
        fi
      done
      url_parts+=("$encoded")
    done
    a=$url_parts[1] b=$url_parts[2] ref=$url_parts[3]
    local url="https://github.com/$a${b:+/$b}"
    [[ -n $ref && -n $b ]] && url="https://raw.githubusercontent.com/$a/$b/$ref/README.md"
    glow "${style[@]}" -p "$url" && return 0
    local ret=$?
    [[ -n $gh_err ]] && print -r -u2 -- "github-view: gh: $gh_err"
    return $ret
  fi

  # Failure: exhausted all options
  [[ -n $gh_err ]] && print -r -u2 -- "github-view: gh: $gh_err"
  print -u2 -- "github-view: --remote needs gh or glow, and a repo or '/code/' path"
  return 1
fi

# Local default: nearest README, walking up from the target directory to the
# repository root (target directory only when outside a repo); separate globs
# because name-sorted alternation would rank bare README over README.md
local d=$dir stop=${root:-$dir}
local -a readmes
while :; do
  readmes=("$d"/(#i)readme.md(N) "$d"/(#i)readme.txt(N) "$d"/(#i)readme(N))
  (( $#readmes )) && break
  [[ $d == "$stop" || $d == / ]] && break
  d=${d:h}
done
(( $#readmes )) || {
  print -u2 -- "github-view: no README found (searched $dir${root:+ up to $root})"
  return 1
}

if command -v glow >/dev/null 2>&1; then
  glow "${style[@]}" -p "${readmes[1]}"
elif command -v bat >/dev/null 2>&1; then
  bat "${readmes[1]}"
else
  less "${readmes[1]}"
fi
return $?
