# vim: ft=zsh

emulate -L zsh

local layout=${DOTFILES_WORKSPACE_LAYOUT:-full}
local editor=${DOTFILES_WORKSPACE_EDITOR_CMD:-nvim .}
local agent=${DOTFILES_WORKSPACE_AGENT_CMD:-ocode}
# An empty status or shell command is skipped.
local status_cmd=${DOTFILES_WORKSPACE_STATUS_CMD-gg}
local shell_cmd=${DOTFILES_WORKSPACE_SHELL_CMD:-}
local dir=$PWD option value task=''
local -i finish=0 arguments=$#
local -a directories=()

while (( $# )); do
  case $1 in
    -h|--help)
      cat <<'EOF'
usage: workspace [OPTIONS] [--] [DIR]
       workspace --task NAME [OPTIONS]
       workspace --done

Lay out a coding workspace: an editor, an agent, and a shell, which runs the
status command, then the shell command, as one command line. In Ghostty on
macOS: in this tab when this shell is its only pane and Ghostty can tell which
pane that is (this shell becomes the workspace's shell, moves to DIR, and runs
its commands), else in a new tab. Inside tmux, the same with windows.
Elsewhere, a tmux session named after DIR, which rerunning workspace in DIR
reattaches. In the workspace's panes, edit (v), rgv, and agents open files in
its editor when it is Neovim, and focus it (edit --help).

Arguments:
  DIR   Workspace directory. Defaults to the current directory.

Options (override environment; also accept --option=VALUE):
  --layout NAME  full (the default) or lean, below.
  --agent CMD    Command started in the agent pane (nonempty).
  --editor CMD   Command started in the editor pane (nonempty).
  --status CMD   Status command the shell starts with. Empty skips.
  --shell CMD    Command the shell runs after the status command. Empty skips.
  -h, --help     Show this help without launching a workspace.
  --             Treat remaining arguments as the directory.

Tasks (in a Git repository):
  --task NAME    Lay out the task's own worktree, REPO.worktrees/NAME beside
                 the main checkout, on branch task/NAME from the commit
                 checked out here. Rerun to reopen it: the agent resumes its
                 last session there (OpenCode, Claude Code, and Codex; other
                 agents start anew). A folder deleted by hand comes back from
                 the branch.
  --done         Alone, in a task's worktree: move this shell to the main
                 checkout and remove the worktree, refused while it holds
                 uncommitted or untracked changes or files Git ignores, then
                 the branch once the main checkout's branch has its commits.

Layouts:
  full   editor left (60% width); on the right (40% width), the agent above
         (65% height) and the shell below (35%)
  lean   editor above the shell on the left (50% width, 50% height each);
         agent right (50% width)

Environment (set lasting defaults in zsh/local.zsh):
  DOTFILES_WORKSPACE_LAYOUT='full'
      Layout: full or lean.

  DOTFILES_WORKSPACE_EDITOR_CMD='nvim .'
      Command started in the editor pane.

  DOTFILES_WORKSPACE_AGENT_CMD='ocode'
      Command started in the agent pane.

  DOTFILES_WORKSPACE_STATUS_CMD='gg'
      Status command the shell starts with. Empty skips. Defaults to gg.

  DOTFILES_WORKSPACE_SHELL_CMD=''
      Command the shell runs after the status command. Empty skips.

  DOTFILES_WORKSPACE_SCRIPT=/path/to/workspace.applescript
      Override the Ghostty AppleScript implementation path.
EOF
      return 0 ;;
    --layout|--agent|--editor|--status|--shell|--task|--layout=*|--agent=*|--editor=*|--status=*|--shell=*|--task=*)
      option=${1%%=*}
      if [[ $1 == *=* ]]; then
        value=${1#*=}
      else
        if (( $# < 2 )) || [[ $2 == (--*|-h) ]]; then
          print -r -u2 -- "workspace: missing value for $option"
          return 1
        fi
        shift
        value=$1
      fi
      if [[ $option == (--agent|--editor) && -z $value ]]; then
        print -r -u2 -- "workspace: $option requires a nonempty command"
        return 1
      fi
      if [[ $option == --task && -z $value ]]; then
        print -u2 -- 'workspace: --task requires a name'
        return 1
      fi
      case $option in
        --layout) layout=$value ;;
        --agent) agent=$value ;;
        --editor) editor=$value ;;
        --status) status_cmd=$value ;;
        --shell) shell_cmd=$value ;;
        --task) task=$value ;;
      esac ;;
    --done) finish=1 ;;
    --) shift; directories+=("$@"); break ;;
    -*) print -r -u2 -- "workspace: unknown option: $1"; return 1 ;;
    *) directories+=("$1") ;;
  esac
  shift
done

# Finishing a task, from its worktree: Git removes the worktree, refusing
# while there is uncommitted work, then the branch once it is merged
if (( finish )); then
  if (( arguments > 1 )); then
    print -u2 -- 'workspace: --done takes no other arguments'
    return 1
  fi
  # A task's worktree is a linked one (its Git directory isn't the common one)
  # on a task/ branch
  local top git_dir common_dir ref
  { read -r top; read -r git_dir; read -r common_dir; read -r ref } <<< "$(git rev-parse --show-toplevel \
    --absolute-git-dir --path-format=absolute --git-common-dir --symbolic-full-name HEAD 2> /dev/null)"
  if [[ $ref != refs/heads/task/* || $git_dir == $common_dir ]]; then
    print -u2 -- "workspace: --done works in a task's worktree, which workspace --task NAME opens"
    return 1
  fi
  local branch=${ref#refs/heads/} checkout listed
  local -a ignored
  # The main checkout is the first worktree Git lists
  checkout=${${(0)"$(git worktree list --porcelain -z)"}[1]#worktree }
  # Git doesn't count the files it ignores (an .env, a local database) as
  # work, and would delete them with the worktree
  ignored=(${(0)"$(git -C "$top" ls-files -z --others --ignored --exclude-standard --directory --no-empty-directory)"})
  if (( $#ignored )); then
    listed=${(j:, :)ignored[1,3]}
    (( $#ignored <= 3 )) || listed+=", and $(( $#ignored - 3 )) more"
    print -r -u2 -- "workspace: task ${branch#task/} stays as it was: removing its worktree would delete files Git ignores: $listed"
    print -r -u2 -- "hint: if they're disposable (node_modules and the like), delete them with: git -C ${(q-)top} clean -fdX"
    return 1
  fi
  if ! git -C "$checkout" worktree remove "$top"; then
    print -r -u2 -- "workspace: task ${branch#task/} stays as it was"
    return 1
  fi
  # Quietly, so the repository's card doesn't push what follows out of sight;
  # git-glance's hook (zsh/.zshrc) then remembers the repository, as below.
  # This shell leaves the task's editor too
  builtin cd -q -- "$checkout" || return
  (( ! ${+_git_glance_last} )) || _git_glance_last=$(git rev-parse --show-toplevel 2> /dev/null)
  unset DOTFILES_EDITOR_SOCKET DOTFILES_EDITOR_SERVE
  print -r -- "workspace: removed task ${branch#task/}'s worktree; its other panes can be closed"
  # The branch goes once the main checkout's branch has its commits: git
  # branch -d would also take one whose upstream alone has them, as once
  # pushed
  if git merge-base --is-ancestor "$ref" HEAD 2> /dev/null; then
    git branch -D "$branch"
  else
    print -r -- "workspace: kept branch $branch, not merged into ${$(git symbolic-ref --short -q HEAD):-HEAD}; to delete it anyway: git branch -D $branch"
  fi
  return 0
fi

if [[ $layout != (full|lean) ]]; then
  print -r -u2 -- "workspace: unknown layout: $layout (full or lean)"
  return 1
fi
# The shell takes both commands as one line, so a status command that reads
# the terminal cannot swallow the shell command as input
local -a startup=(${status_cmd:+"$status_cmd"} ${shell_cmd:+"$shell_cmd"})
shell_cmd=${(j:; :)startup}

if (( ${#directories} > 1 )); then
  print -u2 -- 'workspace: expected at most one directory'
  return 1
fi
dir=${directories[1]:-$PWD}

# The launcher, found before a task changes Git: tmux outside Ghostty on
# macOS, and inside tmux; else Ghostty's script
local script=''
if [[ -n $TMUX || $OSTYPE != darwin* || ${(L)TERM_PROGRAM} != ghostty ]]; then
  (( $+commands[tmux] )) || {
    print -u2 -- 'workspace: tmux not found'
    print -u2 -- 'hint: run: dotfiles bundle'
    return 1
  }
else
  [[ -x /usr/bin/osascript ]] || {
    print -u2 -- 'workspace: /usr/bin/osascript not found'
    return 1
  }
  script=${DOTFILES_WORKSPACE_SCRIPT:-${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/workspace.applescript}
  [[ -r $script ]] || {
    print -r -u2 -- "workspace: missing script: $script"
    print -u2 -- 'hint: run: dotfiles link'
    return 1
  }
fi

if [[ -n $task ]]; then
  if (( ${#directories} )); then
    print -u2 -- 'workspace: --task takes no directory: the task has its own'
    return 1
  fi
  # One segment of a branch name, which also names the worktree's folder
  if [[ $task == (-*|*/*) ]] || ! git check-ref-format --branch "task/$task" > /dev/null 2>&1; then
    print -r -u2 -- "workspace: invalid task name: $task (a branch name, without / or a leading -)"
    return 1
  fi
  # Each worktree's branch by its folder, empty when detached; the main
  # checkout comes first
  local line folder checkout=''
  local -A branches
  for line in ${(0)"$(git worktree list --porcelain -z 2> /dev/null)"}; do
    case $line in
      'worktree '*)
        folder=${line#worktree }
        branches[$folder]=''
        checkout=${checkout:-$folder} ;;
      'branch '*) branches[$folder]=${line#branch } ;;
    esac
  done
  if [[ -z $checkout ]]; then
    print -u2 -- 'workspace: --task works inside a Git repository'
    return 1
  fi
  # Beside the main checkout
  dir=$checkout.worktrees/$task
  local own=refs/heads/task/$task
  if (( ${+branches[$dir]} )) && [[ -d $dir ]]; then
    if [[ $branches[$dir] != $own ]]; then
      local now=${branches[$dir]:+on ${branches[$dir]#refs/heads/}}
      print -r -u2 -- "workspace: task $task's worktree is ${now:-detached}, not on task/$task; to switch it back: git -C ${(q-)dir} switch task/$task"
      return 1
    fi
    # Reopened, the agent resumes its last session in this folder, by the
    # flags that ask for this folder's alone (Copilot CLI's --continue falls
    # back to another folder's)
    local program=${agent%%[[:space:]]*}
    case $program in
      ocode|opencode|claude) agent="$program --continue${agent#$program}" ;;
      codex) agent="$program resume --last${agent#$program}" ;;
    esac
  else
    # A folder deleted by hand leaves its worktree registered: Git drops that
    # registration alone and the branch comes back there, unless another
    # worktree has it checked out
    if (( ${+branches[$dir]} )); then
      for folder in ${(k)branches}; do
        [[ $folder != $dir && $branches[$folder] == $own ]] || continue
        print -r -u2 -- "workspace: task $task's folder is gone, and task/$task is checked out in $folder; to free the branch: git -C ${(q-)folder} switch --detach"
        return 1
      done
      git worktree remove "$dir" || return
    fi
    if git show-ref -q --verify "$own"; then
      git worktree add -q "$dir" "task/$task" || return
    else
      git worktree add -q -b "task/$task" "$dir" || return
    fi
  fi
fi

[[ -d $dir ]] || {
  print -r -u2 -- "workspace: not a directory: $dir"
  return 1
}
dir=${dir:A}

# Every pane the workspace starts gets the socket its editor serves
# (config.workspace) for edit and rgv: one per workspace folder, in Neovim's
# runtime folder, private as Neovim keeps it
local socket='' run=${${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}%/}/nvim.$USERNAME
mkdir -p -m 700 -- $run 2> /dev/null
local -a private=($run(N/Uf:go-rwx:))
(( ! $#private )) || socket=$run/ws-${"$(print -rn -- $dir | cksum)"%% *}.sock

# Outside Ghostty on macOS, and inside tmux, tmux lays out the same panes.
if [[ -z $script ]]; then
  local name line main here='' agent_pane editor_pane focus pane command
  # The editor's pane alone also gets the flag for its Neovim to serve the
  # socket (config.workspace)
  local -a with_socket=(${socket:+-e} ${socket:+DOTFILES_EDITOR_SOCKET=$socket})
  local -a serving=(${socket:+-e} ${socket:+DOTFILES_EDITOR_SERVE=1})
  if [[ -z $TMUX ]]; then
    for line in ${(f)"$(tmux list-sessions -F '#{session_name}:#{session_path}' 2>/dev/null)"}; do
      [[ ${line#*:} == "$dir" ]] && name=${line%%:*} && break
    done
  fi
  if [[ -z $name ]]; then
    if [[ -n $TMUX ]]; then
      # A window holding only this shell becomes the workspace around it; the
      # pane's terminal tells this shell from one nested in another program
      if [[ -n $TMUX_PANE && -n $TTY &&
          $(tmux display -p -t "$TMUX_PANE" '#{window_panes} #{pane_tty}' 2>/dev/null) == "1 $TTY" ]]; then
        main=$TMUX_PANE here=1
        tmux rename-window -t "$main" -- "${dir:t}" || return
      else
        main=$(tmux new-window $with_socket -P -F '#{pane_id}' -n "${dir:t}" -c "$dir") || return
      fi
    else
      # Session names cannot hold . or :, and stay unique per directory
      name=${${${dir:t}:-root}//[.:]/_}
      local base=$name
      local -i n=1
      while tmux has-session -t "=$name" 2>/dev/null; do
        name=$base-$(( ++n ))
      done
      # Sized like this terminal: tmux keeps no shares when attaching resizes it
      main=$(tmux new-session -d $with_socket -x - -y - -P -F '#{pane_id}' -s "$name" -c "$dir") || return
      # The first pane keeps the socket, the session's environment doesn't:
      # every pane opened later would take it
      tmux set-environment -t "=$name" -u DOTFILES_EDITOR_SOCKET || return
    fi
    # The window keeps the socket for the panes tmux's keys split from it
    # later (tmux/tmux.conf)
    tmux set-option -w -t "$main" @dotfiles_editor_socket "$socket" || return
    # The other panes split from the shell, each taking a share of it.
    if [[ $layout == lean ]]; then
      # Even halves: the agent right, the editor above the shell
      agent_pane=$(tmux split-window $with_socket -h -l 50% -t "$main" -P -F '#{pane_id}' -c "$dir") || return
      editor_pane=$(tmux split-window $with_socket $serving -v -b -l 50% -t "$main" -P -F '#{pane_id}' -c "$dir") || return
      focus=$main
    else
      # The editor left at 60% of the width, the agent above the shell at 65%
      # of the height
      editor_pane=$(tmux split-window $with_socket $serving -h -b -l 60% -t "$main" -P -F '#{pane_id}' -c "$dir") || return
      agent_pane=$(tmux split-window $with_socket -v -b -l 65% -t "$main" -P -F '#{pane_id}' -c "$dir") || return
      focus=$editor_pane
    fi
    # A reused shell runs its own commands below: typed into it, they could
    # reach a program run after workspace
    for pane command in "$editor_pane" "$editor" "$agent_pane" "$agent" "$main" "$shell_cmd"; do
      [[ -n $command ]] || continue
      [[ -n $here && $pane == $main ]] && continue
      tmux send-keys -t "$pane" -l -- "$command" || return
      tmux send-keys -t "$pane" Enter || return
    done
    tmux select-pane -t "$focus" || return
    if [[ -n $here ]]; then
      # As the workspace's shell, this one moves to the workspace quietly, as
      # the other panes start there; git-glance's hook (zsh/.zshrc) then
      # remembers the workspace's repository, as for a shell started there
      if [[ ${PWD:A} != $dir ]]; then
        builtin cd -q -- "$dir" || return
        (( ! ${+_git_glance_last} )) || _git_glance_last=$(git rev-parse --show-toplevel 2>/dev/null)
      fi
      export DOTFILES_EDITOR_SOCKET=$socket
      unset DOTFILES_EDITOR_SERVE
      [[ -z $shell_cmd ]] || eval "$shell_cmd"
    fi
  fi
  [[ -z $TMUX ]] || return 0
  if [[ -t 0 && -t 1 ]]; then
    tmux attach-session -t "=$name"
  else
    print -r -- "workspace: tmux session $name is ready; attach with: tmux attach -t ${(q-):-=$name}"
  fi
  return
fi

# Window text area in pixels (CSI 14 t) for the full layout's ratio-based split
# sizing. Measured from the invoking pane: exact from an unsplit tab, undersized
# from a split pane; on 0 the AppleScript leaves the splits even.
local width=0 height=0
if [[ $layout == full && -t 0 && ${(L)TERM_PROGRAM} == ghostty ]]; then
  local dimensions
  if dimensions=$(
    local tty saved reply='' char=''
    local -a match
    local MATCH MBEGIN MEND
    local -a mbegin mend
    # Byte reads cannot block waiting for the rest of a multibyte character.
    local LC_ALL=C
    local -F SECONDS=0 deadline remaining
    exec {tty}<> /dev/tty || exit 1
    saved=$(command stty -g <&$tty) || exit 1
    trap 'command stty "$saved" <&$tty' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    command stty -echo -echonl -icanon min 1 time 0 <&$tty || exit 1
    deadline=$(( SECONDS + 1 ))
    printf '\e[14t' >&$tty || exit 1
    while (( ${#reply} < 32 )); do
      remaining=$(( deadline - SECONDS ))
      (( remaining > 0 )) || exit 1
      read -r -k 1 -u $tty -t $remaining char || exit 1
      reply+=$char
      [[ $char == t ]] && break
    done
    [[ $reply =~ $'^\e\\[4;([0-9]{1,6});([0-9]{1,6})t$' ]] || exit 1
    (( 10#$match[1] > 0 && 10#$match[2] > 0 )) || exit 1
    print -r -- "$(( 10#$match[2] )) $(( 10#$match[1] ))"
  ); then
    width=${dimensions%% *}
    height=${dimensions##* }
  fi
fi

local output mark=''
local -i rc=0 served=0
# Ghostty can't tell a shell which pane it runs in, so this shell titles its
# own pane with a unique mark for the script to find; the next prompt's title
# replaces it
if [[ -t 0 ]]; then
  mark="workspace $$.$RANDOM"
  print -rn -- $'\e]2;'"$mark"$'\a' 2>/dev/null > /dev/tty || mark=''
fi
# Nor can it tell edit which pane the editor runs in: the script prints its
# id, which goes beside the socket, unless an editor serves this folder
# already. zsocket silently cuts a path longer than a socket address holds
# (104 bytes on macOS), so it connects from the socket's folder
if [[ -n $socket ]] && zmodload -F zsh/net/socket b:zsocket 2>/dev/null &&
    ( builtin cd -q -- ${socket:h} && zsocket ${socket:t} ) 2>/dev/null; then
  served=1
fi
output=$(
  /usr/bin/osascript "$script" "$dir" \
    "$editor" "$agent" "$shell_cmd" \
    "$width" "$height" "$layout" "$mark" "$socket" \
    2>&1
) || {
  rc=$?
  output=${output//$'\n'/ }
  [[ -n $output ]] || output="osascript exited with status $rc"
  print -r -u2 -- "workspace: $output"
  return $rc
}
local -a printed=("${(@f)output}")
(( served )) || [[ -z $socket || -z $printed[-2] ]] || print -r -- $printed[-2] > ${socket%.sock}.ghostty
# Laid out around this shell, which becomes the workspace's shell: it moves to
# the workspace quietly, as the other panes start there (git-glance's hook then
# remembers the workspace's repository, as above), and runs its own commands,
# titled as the shell integration titles a command (the script types none into
# it)
if [[ ${output##*$'\n'} == 'same tab' ]]; then
  if [[ ${PWD:A} != $dir ]]; then
    builtin cd -q -- "$dir" || return
    (( ! ${+_git_glance_last} )) || _git_glance_last=$(git rev-parse --show-toplevel 2>/dev/null)
  fi
  export DOTFILES_EDITOR_SOCKET=$socket
  unset DOTFILES_EDITOR_SERVE
  if [[ -n $shell_cmd ]]; then
    [[ -z $mark ]] || print -rn -- $'\e]2;'"$shell_cmd"$'\a' 2>/dev/null > /dev/tty
    eval "$shell_cmd"
  fi
fi
