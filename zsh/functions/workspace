# vim: ft=zsh

emulate -L zsh

local editor=${DOTFILES_WORKSPACE_EDITOR_CMD:-nvim .}
local agent=${DOTFILES_WORKSPACE_AGENT_CMD:-ocode}
# Empty middle commands skip their pane's startup command.
local middle_top=${DOTFILES_WORKSPACE_MIDDLE_TOP_CMD-ggg}
local middle_bottom=${DOTFILES_WORKSPACE_MIDDLE_BOTTOM_CMD:-}
local dir=$PWD option value
local -a directories=()

while (( $# )); do
  case $1 in
    -h|--help)
      cat <<'EOF'
usage: workspace [OPTIONS] [--] [DIR]

Lay out a coding workspace: a new tab in Ghostty on macOS; elsewhere a tmux
window (inside tmux) or a tmux session named after DIR, which rerunning
workspace in DIR reattaches.

Arguments:
  DIR   Workspace directory. Defaults to the current directory.

Options (override environment; also accept --option=CMD):
  --agent CMD          Command started in the right pane (nonempty).
  --editor CMD         Command started in the left pane (nonempty).
  --middle-top CMD     Middle-top command. Empty skips.
  --middle-bottom CMD  Middle-bottom command. Empty skips.
  -h, --help           Show this help without launching a workspace.
  --                   Treat remaining arguments as the directory.

Layout:
  left           editor  (20% width)
  middle top     shell   (40% width, 30% height)
  middle bottom  shell   (40% width, 70% height)
  right          agent   (40% width)

Environment:
  DOTFILES_WORKSPACE_SCRIPT=/path/to/workspace.applescript
      Override the Ghostty AppleScript implementation path.

  DOTFILES_WORKSPACE_EDITOR_CMD='nvim .'
      Command started in the left pane.

  DOTFILES_WORKSPACE_AGENT_CMD='ocode'
      Command started in the right pane.

  DOTFILES_WORKSPACE_MIDDLE_TOP_CMD='ggg'
      Command started in the middle-top pane. Empty skips. Defaults to ggg.

  DOTFILES_WORKSPACE_MIDDLE_BOTTOM_CMD=''
      Command started in the middle-bottom pane. Empty skips.
EOF
      return 0 ;;
    --agent|--editor|--middle-top|--middle-bottom|--agent=*|--editor=*|--middle-top=*|--middle-bottom=*)
      option=${1%%=*}
      if [[ $1 == *=* ]]; then
        value=${1#*=}
      else
        if (( $# < 2 )) || [[ $2 == (--*|-h) ]]; then
          print -r -u2 -- "workspace: missing value for $option"
          return 1
        fi
        shift
        value=$1
      fi
      if [[ $option == (--agent|--editor) && -z $value ]]; then
        print -r -u2 -- "workspace: $option requires a nonempty command"
        return 1
      fi
      case $option in
        --agent) agent=$value ;;
        --editor) editor=$value ;;
        --middle-top) middle_top=$value ;;
        --middle-bottom) middle_bottom=$value ;;
      esac ;;
    --) shift; directories+=("$@"); break ;;
    -*) print -r -u2 -- "workspace: unknown option: $1"; return 1 ;;
    *) directories+=("$1") ;;
  esac
  shift
done

if (( ${#directories} > 1 )); then
  print -u2 -- 'workspace: expected at most one directory'
  return 1
fi
dir=${directories[1]:-$PWD}

[[ -d $dir ]] || {
  print -r -u2 -- "workspace: not a directory: $dir"
  return 1
}
dir=${dir:A}

# Outside Ghostty on macOS, and inside tmux, tmux lays out the same panes.
if [[ -n $TMUX || $OSTYPE != darwin* || ${(L)TERM_PROGRAM} != ghostty ]]; then
  (( $+commands[tmux] )) || {
    print -u2 -- 'workspace: tmux not found'
    print -u2 -- 'hint: run: dotfiles bundle'
    return 1
  }
  local name line top agent_pane editor_pane bottom_pane pane command
  if [[ -z $TMUX ]]; then
    for line in ${(f)"$(tmux list-sessions -F '#{session_name}:#{session_path}' 2>/dev/null)"}; do
      [[ ${line#*:} == "$dir" ]] && name=${line%%:*} && break
    done
  fi
  if [[ -z $name ]]; then
    if [[ -n $TMUX ]]; then
      top=$(tmux new-window -P -F '#{pane_id}' -n "${dir:t}" -c "$dir") || return
    else
      # Session names cannot hold . or :, and stay unique per directory
      name=${${${dir:t}:-root}//[.:]/_}
      local base=$name
      local -i n=1
      while tmux has-session -t "=$name" 2>/dev/null; do
        name=$base-$(( ++n ))
      done
      # Sized like this terminal: tmux keeps no shares when attaching resizes it
      top=$(tmux new-session -d -x - -y - -P -F '#{pane_id}' -s "$name" -c "$dir") || return
    fi
    # Widths 20/40/40 and middle heights 30/70: each split takes a share of
    # the pane it divides.
    agent_pane=$(tmux split-window -h -l 40% -t "$top" -P -F '#{pane_id}' -c "$dir") || return
    editor_pane=$(tmux split-window -h -b -l 33% -t "$top" -P -F '#{pane_id}' -c "$dir") || return
    bottom_pane=$(tmux split-window -v -l 70% -t "$top" -P -F '#{pane_id}' -c "$dir") || return
    for pane command in "$editor_pane" "$editor" "$agent_pane" "$agent" \
      "$top" "$middle_top" "$bottom_pane" "$middle_bottom"; do
      [[ -n $command ]] || continue
      tmux send-keys -t "$pane" -l -- "$command" || return
      tmux send-keys -t "$pane" Enter || return
    done
    tmux select-pane -t "$bottom_pane" || return
  fi
  [[ -z $TMUX ]] || return 0
  if [[ -t 0 && -t 1 ]]; then
    tmux attach-session -t "=$name"
  else
    print -r -- "workspace: tmux session $name is ready; attach with: tmux attach -t ${(q-):-=$name}"
  fi
  return
fi

[[ -x /usr/bin/osascript ]] || {
  print -u2 -- 'workspace: /usr/bin/osascript not found'
  return 1
}

local script=${DOTFILES_WORKSPACE_SCRIPT:-${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/workspace.applescript}
[[ -r $script ]] || {
  print -r -u2 -- "workspace: missing script: $script"
  print -u2 -- 'hint: run: dotfiles link'
  return 1
}

# Window text area in pixels (CSI 14 t) for the ratio-based split sizing.
# Measured from the invoking pane: exact from an unsplit tab, undersized from
# a split pane; on 0 the AppleScript falls back to equalized splits.
local width=0 height=0
if [[ -t 0 && ${(L)TERM_PROGRAM} == ghostty ]]; then
  local dimensions
  if dimensions=$(
    local tty saved reply='' char=''
    local -a match
    local MATCH MBEGIN MEND
    local -a mbegin mend
    # Byte reads cannot block waiting for the rest of a multibyte character.
    local LC_ALL=C
    local -F SECONDS=0 deadline remaining
    exec {tty}<> /dev/tty || exit 1
    saved=$(command stty -g <&$tty) || exit 1
    trap 'command stty "$saved" <&$tty' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    command stty -echo -echonl -icanon min 1 time 0 <&$tty || exit 1
    deadline=$(( SECONDS + 1 ))
    printf '\e[14t' >&$tty || exit 1
    while (( ${#reply} < 32 )); do
      remaining=$(( deadline - SECONDS ))
      (( remaining > 0 )) || exit 1
      read -r -k 1 -u $tty -t $remaining char || exit 1
      reply+=$char
      [[ $char == t ]] && break
    done
    [[ $reply =~ $'^\e\\[4;([0-9]{1,6});([0-9]{1,6})t$' ]] || exit 1
    (( 10#$match[1] > 0 && 10#$match[2] > 0 )) || exit 1
    print -r -- "$(( 10#$match[2] )) $(( 10#$match[1] ))"
  ); then
    width=${dimensions%% *}
    height=${dimensions##* }
  fi
fi

local output
local -i rc=0
output=$(
  /usr/bin/osascript "$script" "$dir" \
    "$editor" "$agent" "$middle_top" "$middle_bottom" \
    "$width" "$height" \
    2>&1
) || {
  rc=$?
  output=${output//$'\n'/ }
  [[ -n $output ]] || output="osascript exited with status $rc"
  print -r -u2 -- "workspace: $output"
  return $rc
}
