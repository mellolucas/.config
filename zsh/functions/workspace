# vim: ft=zsh

emulate -L zsh

local layout=${DOTFILES_WORKSPACE_LAYOUT:-full}
local editor=${DOTFILES_WORKSPACE_EDITOR_CMD:-nvim .}
local agent=${DOTFILES_WORKSPACE_AGENT_CMD:-ocode}
# Empty shell commands skip their pane's startup command.
local status_cmd=${DOTFILES_WORKSPACE_STATUS_CMD-ggg}
local shell_cmd=${DOTFILES_WORKSPACE_SHELL_CMD:-}
local dir=$PWD option value
local -a directories=()

while (( $# )); do
  case $1 in
    -h|--help)
      cat <<'EOF'
usage: workspace [OPTIONS] [--] [DIR]

Lay out a coding workspace. In Ghostty on macOS: in this tab when this shell
is its only pane (the shell becomes the main one and moves to DIR), else in a
new tab. Inside tmux, the same with windows. Elsewhere, a tmux session named
after DIR, which rerunning workspace in DIR reattaches.

Arguments:
  DIR   Workspace directory. Defaults to the current directory.

Options (override environment; also accept --option=VALUE):
  --layout NAME  full (the default) or lean, below.
  --agent CMD    Command started in the agent pane (nonempty).
  --editor CMD   Command started in the editor pane (nonempty).
  --status CMD   Command the status shell starts with. Empty skips.
  --shell CMD    Command the main shell starts with. Empty skips.
  -h, --help     Show this help without launching a workspace.
  --             Treat remaining arguments as the directory.

Layouts:
  full   editor left (20% width); in the middle (40% width), the status shell
         above (30% height) and the main shell below (70%); agent right (40%)
  lean   editor above one shell on the left (50% width, 50% height each),
         which runs the status command, then the shell command, as one
         command line; agent right (50% width)

Environment (set lasting defaults in zsh/local.zsh):
  DOTFILES_WORKSPACE_LAYOUT='full'
      Layout: full or lean.

  DOTFILES_WORKSPACE_EDITOR_CMD='nvim .'
      Command started in the editor pane.

  DOTFILES_WORKSPACE_AGENT_CMD='ocode'
      Command started in the agent pane.

  DOTFILES_WORKSPACE_STATUS_CMD='ggg'
      Command the status shell starts with. Empty skips. Defaults to ggg.

  DOTFILES_WORKSPACE_SHELL_CMD=''
      Command the main shell starts with. Empty skips.

  DOTFILES_WORKSPACE_SCRIPT=/path/to/workspace.applescript
      Override the Ghostty AppleScript implementation path.
EOF
      return 0 ;;
    --layout|--agent|--editor|--status|--shell|--layout=*|--agent=*|--editor=*|--status=*|--shell=*)
      option=${1%%=*}
      if [[ $1 == *=* ]]; then
        value=${1#*=}
      else
        if (( $# < 2 )) || [[ $2 == (--*|-h) ]]; then
          print -r -u2 -- "workspace: missing value for $option"
          return 1
        fi
        shift
        value=$1
      fi
      if [[ $option == (--agent|--editor) && -z $value ]]; then
        print -r -u2 -- "workspace: $option requires a nonempty command"
        return 1
      fi
      case $option in
        --layout) layout=$value ;;
        --agent) agent=$value ;;
        --editor) editor=$value ;;
        --status) status_cmd=$value ;;
        --shell) shell_cmd=$value ;;
      esac ;;
    --) shift; directories+=("$@"); break ;;
    -*) print -r -u2 -- "workspace: unknown option: $1"; return 1 ;;
    *) directories+=("$1") ;;
  esac
  shift
done

if [[ $layout != (full|lean) ]]; then
  print -r -u2 -- "workspace: unknown layout: $layout (full or lean)"
  return 1
fi
# The lean layout's one shell takes both commands as one line, so a status
# command that reads the terminal cannot swallow the shell command as input
if [[ $layout == lean && -n $status_cmd && -n $shell_cmd ]]; then
  status_cmd="$status_cmd; $shell_cmd" shell_cmd=''
fi

if (( ${#directories} > 1 )); then
  print -u2 -- 'workspace: expected at most one directory'
  return 1
fi
dir=${directories[1]:-$PWD}

[[ -d $dir ]] || {
  print -r -u2 -- "workspace: not a directory: $dir"
  return 1
}
dir=${dir:A}

# Outside Ghostty on macOS, and inside tmux, tmux lays out the same panes.
if [[ -n $TMUX || $OSTYPE != darwin* || ${(L)TERM_PROGRAM} != ghostty ]]; then
  (( $+commands[tmux] )) || {
    print -u2 -- 'workspace: tmux not found'
    print -u2 -- 'hint: run: dotfiles bundle'
    return 1
  }
  local name line main here='' agent_pane editor_pane status_pane pane command
  if [[ -z $TMUX ]]; then
    for line in ${(f)"$(tmux list-sessions -F '#{session_name}:#{session_path}' 2>/dev/null)"}; do
      [[ ${line#*:} == "$dir" ]] && name=${line%%:*} && break
    done
  fi
  if [[ -z $name ]]; then
    if [[ -n $TMUX ]]; then
      # A window holding only this shell becomes the workspace around it; the
      # pane's terminal tells this shell from one nested in another program
      if [[ -n $TMUX_PANE && -n $TTY &&
          $(tmux display -p -t "$TMUX_PANE" '#{window_panes} #{pane_tty}' 2>/dev/null) == "1 $TTY" ]]; then
        main=$TMUX_PANE here=1
        tmux rename-window -t "$main" -- "${dir:t}" || return
      else
        main=$(tmux new-window -P -F '#{pane_id}' -n "${dir:t}" -c "$dir") || return
      fi
    else
      # Session names cannot hold . or :, and stay unique per directory
      name=${${${dir:t}:-root}//[.:]/_}
      local base=$name
      local -i n=1
      while tmux has-session -t "=$name" 2>/dev/null; do
        name=$base-$(( ++n ))
      done
      # Sized like this terminal: tmux keeps no shares when attaching resizes it
      main=$(tmux new-session -d -x - -y - -P -F '#{pane_id}' -s "$name" -c "$dir") || return
    fi
    # The other panes split from the main shell, each taking a share of it.
    if [[ $layout == lean ]]; then
      # Even halves: the agent right, the editor above the one shell
      agent_pane=$(tmux split-window -h -l 50% -t "$main" -P -F '#{pane_id}' -c "$dir") || return
      editor_pane=$(tmux split-window -v -b -l 50% -t "$main" -P -F '#{pane_id}' -c "$dir") || return
      status_pane=$main
    else
      # Widths 20/40/40, and the middle column's heights 30/70
      editor_pane=$(tmux split-window -h -b -l 20% -t "$main" -P -F '#{pane_id}' -c "$dir") || return
      agent_pane=$(tmux split-window -h -l 50% -t "$main" -P -F '#{pane_id}' -c "$dir") || return
      status_pane=$(tmux split-window -v -b -l 30% -t "$main" -P -F '#{pane_id}' -c "$dir") || return
    fi
    # A reused shell runs its own commands below: typed into it, they could
    # reach a program run after workspace
    local -a own=()
    for pane command in "$editor_pane" "$editor" "$agent_pane" "$agent" \
      "$status_pane" "$status_cmd" "$main" "$shell_cmd"; do
      [[ -n $command ]] || continue
      if [[ -n $here && $pane == $main ]]; then own+=("$command"); continue; fi
      tmux send-keys -t "$pane" -l -- "$command" || return
      tmux send-keys -t "$pane" Enter || return
    done
    tmux select-pane -t "$main" || return
    if [[ -n $here ]]; then
      # As the main shell, this one moves to the workspace quietly, as the
      # other panes start there; git-glance's hook (zsh/.zshrc) then remembers
      # the workspace's repository, as for a shell started there
      if [[ ${PWD:A} != $dir ]]; then
        builtin cd -q -- "$dir" || return
        (( ! ${+_git_glance_last} )) || _git_glance_last=$(git rev-parse --show-toplevel 2>/dev/null)
      fi
      for command in $own; do eval "$command"; done
    fi
  fi
  [[ -z $TMUX ]] || return 0
  if [[ -t 0 && -t 1 ]]; then
    tmux attach-session -t "=$name"
  else
    print -r -- "workspace: tmux session $name is ready; attach with: tmux attach -t ${(q-):-=$name}"
  fi
  return
fi

[[ -x /usr/bin/osascript ]] || {
  print -u2 -- 'workspace: /usr/bin/osascript not found'
  return 1
}

local script=${DOTFILES_WORKSPACE_SCRIPT:-${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/workspace.applescript}
[[ -r $script ]] || {
  print -r -u2 -- "workspace: missing script: $script"
  print -u2 -- 'hint: run: dotfiles link'
  return 1
}

# Window text area in pixels (CSI 14 t) for the full layout's ratio-based split
# sizing. Measured from the invoking pane: exact from an unsplit tab, undersized
# from a split pane; on 0 the AppleScript falls back to equalized splits.
local width=0 height=0
if [[ $layout == full && -t 0 && ${(L)TERM_PROGRAM} == ghostty ]]; then
  local dimensions
  if dimensions=$(
    local tty saved reply='' char=''
    local -a match
    local MATCH MBEGIN MEND
    local -a mbegin mend
    # Byte reads cannot block waiting for the rest of a multibyte character.
    local LC_ALL=C
    local -F SECONDS=0 deadline remaining
    exec {tty}<> /dev/tty || exit 1
    saved=$(command stty -g <&$tty) || exit 1
    trap 'command stty "$saved" <&$tty' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    command stty -echo -echonl -icanon min 1 time 0 <&$tty || exit 1
    deadline=$(( SECONDS + 1 ))
    printf '\e[14t' >&$tty || exit 1
    while (( ${#reply} < 32 )); do
      remaining=$(( deadline - SECONDS ))
      (( remaining > 0 )) || exit 1
      read -r -k 1 -u $tty -t $remaining char || exit 1
      reply+=$char
      [[ $char == t ]] && break
    done
    [[ $reply =~ $'^\e\\[4;([0-9]{1,6});([0-9]{1,6})t$' ]] || exit 1
    (( 10#$match[1] > 0 && 10#$match[2] > 0 )) || exit 1
    print -r -- "$(( 10#$match[2] )) $(( 10#$match[1] ))"
  ); then
    width=${dimensions%% *}
    height=${dimensions##* }
  fi
fi

local output mark=''
local -i rc=0
# Ghostty can't tell a shell which pane it runs in, so this shell titles its
# own pane with a unique mark for the script to find; the next prompt's title
# replaces it
if [[ -t 0 ]]; then
  mark="workspace $$.$RANDOM"
  print -rn -- $'\e]2;'"$mark"$'\a' 2>/dev/null > /dev/tty || mark=''
fi
output=$(
  /usr/bin/osascript "$script" "$dir" \
    "$editor" "$agent" "$status_cmd" "$shell_cmd" \
    "$width" "$height" "$layout" "$mark" \
    2>&1
) || {
  rc=$?
  output=${output//$'\n'/ }
  [[ -n $output ]] || output="osascript exited with status $rc"
  print -r -u2 -- "workspace: $output"
  return $rc
}
# Laid out around this shell, the main one: it moves to the workspace quietly,
# as the other panes start there (git-glance's hook then remembers the
# workspace's repository, as above), and runs its own commands, titled as the
# shell integration titles a command (the script types none into it)
if [[ ${output##*$'\n'} == 'same tab' ]]; then
  local command
  local -a own=("$shell_cmd")
  [[ $layout == full ]] || own=("$status_cmd" "$shell_cmd")
  if [[ ${PWD:A} != $dir ]]; then
    builtin cd -q -- "$dir" || return
    (( ! ${+_git_glance_last} )) || _git_glance_last=$(git rev-parse --show-toplevel 2>/dev/null)
  fi
  for command in $own; do
    [[ -z $mark ]] || print -rn -- $'\e]2;'"$command"$'\a' 2>/dev/null > /dev/tty
    eval "$command"
  done
fi
