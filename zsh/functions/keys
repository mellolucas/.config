# vim: ft=zsh

emulate -L zsh
local source_file=${${(%):-%x}:A}
local repo=${source_file:h:h:h}
local guide=$repo/GUIDE.md topic='' plain=0 usage=0
local arg line previous='' row current='' title='' intro='' content='' index='# Working here'
local -i labelled=0
local -a topics labels
local -A pages titles

for arg in "$@"; do
  case $arg in
    --plain) plain=1 ;;
    -h|--help) usage=1 ;;
    -*) print -ru2 -- "keys: unknown option: $arg"; return 1 ;;
    *)
      [[ -z $topic ]] || { print -u2 'usage: keys [TOPIC|all] [--plain]'; return 1 }
      topic=$arg ;;
  esac
done
[[ -r $guide ]] || { print -ru2 -- "keys: guide not found: $guide"; return 1 }

# Each level-two heading is a page: "## Topic: Task title". The picker lists each
# page by its first prose line, then each table row so keys and commands match.
while IFS= read -r line || [[ -n $line ]]; do
  if [[ $line == '## '*': '* ]]; then
    current=${${line#'## '}%%:*}
    current=${(L)current}
    title=${line#*: }
    topics+=("$current")
    titles[$current]=$title
    pages[$current]="# $title"$'\n'
    labelled=0
  elif [[ -n $current ]]; then
    pages[$current]+="$line"$'\n'
    if [[ $line == '| '* ]]; then
      # Rows below the header and separator; previous line is part of the table.
      if [[ $previous == '|'* && $line != '| ---'* ]]; then
        row=${${line#'| '}%' |'}
        labels+=("$current"$'\t'"  ${${row%% | *}//\`/}  ${${row#* | }//\`/}")
      fi
    elif [[ -n $line ]] && (( ! labelled )); then
      labels+=("$current"$'\t'"$title - $line")
      labelled=1
    fi
  else
    intro+="$line"$'\n'
  fi
  previous=$line
done < "$guide"
(( ${#topics} )) || { print -u2 'keys: guide has no topics'; return 1 }
index+=$'\n\nChoose a task with `keys TOPIC`.\n\n'
for current in "${topics[@]}"; do
  index+="- \`keys $current\` - $titles[$current]"$'\n'
done
index+=$'\n`keys all` reads everything. `keys --plain` needs no viewer.\n'

if (( usage )); then
  print -r -- 'usage: keys [TOPIC|all] [--plain]'
  print -r -- "$index"
  return 0
fi
if [[ -z $topic && -t 0 && -t 1 ]] && (( ! plain )) && command -v fzf >/dev/null 2>&1; then
  local selection result=0
  selection=$(print -rl -- "${labels[@]}" | FZF_DEFAULT_OPTS= FZF_DEFAULT_OPTS_FILE=/dev/null \
    fzf --layout=reverse --no-multi --wrap --delimiter=$'\t' --with-nth=2.. \
      --prompt='Find a task > ' --header=$'Working here\nEnter reads a page. Esc returns to the shell.') || result=$?
  case $result in
    0) topic=${selection%%$'\t'*} ;;
    1|130) return 0 ;;
    *) return $result ;;
  esac
fi

case $topic in
  '') content=$index ;;
  all)
    content=$intro
    for current in "${topics[@]}"; do content+=$'\n'"$pages[$current]"; done ;;
  *)
    [[ -n ${pages[$topic]-} ]] || { print -ru2 -- "keys: unknown topic '$topic'; run keys --help"; return 1 }
    content=$pages[$topic] ;;
esac
content+=$'\n---\n`Option+b` is a left-Option chord; `Space t m` is typed in Neovim normal mode. `keys` picks another task; `q` leaves the reader.\n'

if (( ! plain )) && [[ -t 1 ]] && command -v glow >/dev/null 2>&1 && command -v less >/dev/null 2>&1; then
  local width=$(( COLUMNS > 0 && COLUMNS < 80 ? COLUMNS : 80 ))
  print -r -- "$content" | PAGER='less -R' LESS=-R glow --style "$repo/glow/guide.json" --width "$width" --pager -
else
  print -r -- "$content"
fi
