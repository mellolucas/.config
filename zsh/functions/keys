# vim: ft=zsh

emulate -L zsh
local source_file=${${(%):-%x}:A}
local repo=${source_file:h:h:h}
local guide=$repo/GUIDE.md topic='' plain=0 usage=0
local arg line previous='' row current='' title='' intro='' content='' index='# Working here' text
local -i labelled=0
local -a topics labels words intro_labels
local -A pages titles

for arg in "$@"; do
  case $arg in
    --plain) plain=1 ;;
    -h|--help) usage=1 ;;
    -*) print -ru2 -- "keys: unknown option: $arg"; return 1 ;;
    *) words+=("$arg") ;;
  esac
done
[[ -r $guide ]] || { print -ru2 -- "keys: guide not found: $guide"; return 1 }

# Each level-two heading is a page: "## Topic: Task title". The picker lists each
# page by its first prose line, then each table row and bullet, so keys,
# commands, and tips all match a search.
while IFS= read -r line || [[ -n $line ]]; do
  if [[ $line == '## '*': '* ]]; then
    current=${${line#'## '}%%:*}
    current=${(L)current}
    title=${line#*: }
    topics+=("$current")
    titles[$current]=$title
    pages[$current]="# $title"$'\n'
    labelled=0
  elif [[ -n $current ]]; then
    pages[$current]+="$line"$'\n'
    text=${${line//\`/}//\*\*/}
    if [[ $line == '| '* ]]; then
      # Rows below the header and separator; previous line is part of the table.
      if [[ $previous == '|'* && $line != '| ---'* ]]; then
        row=${${line#'| '}%' |'}
        labels+=("$current"$'\t'"  ${${row%% | *}//\`/}  ${${row#* | }//\`/}")
      fi
    elif [[ $line == '- '* ]]; then
      labels+=("$current"$'\t'"  ${text#'- '}")
    elif [[ -n $line ]] && (( ! labelled )); then
      labels+=("$current"$'\t'"$title - $text")
      labelled=1
    elif [[ -n $line ]]; then
      labels+=("$current"$'\t'"  $text")
    fi
  else
    intro+="$line"$'\n'
    # The introduction's lines open the whole guide.
    [[ -z $line || $line == '#'* ]] || intro_labels+=("all"$'\t'"  ${${line//\`/}//\*\*/}")
  fi
  previous=$line
done < "$guide"
labels+=("${intro_labels[@]}")
(( ${#topics} )) || { print -u2 'keys: guide has no topics'; return 1 }
index+=$'\n\nChoose a task with `keys TOPIC`, or search every line with `keys WORDS`.\n\n'
for current in "${topics[@]}"; do
  index+="- \`keys $current\` - $titles[$current]"$'\n'
done
index+=$'\n`keys all` reads everything. `keys --plain` needs no viewer.\n'

if (( usage )); then
  print -r -- 'usage: keys [TOPIC|all|WORDS...] [--plain]'
  print -r -- "$index"
  return 0
fi

# One page name opens that page; any other words search every entry.
local query=''
if (( $#words == 1 )) && [[ $words[1] == all || -n ${pages[$words[1]]-} ]]; then
  topic=$words[1]
else
  query=${(j: :)words}
fi
# Entries show their topic, so a search keeps each result's page in view.
local -i pad=0
for current in "${topics[@]}"; do (( pad = ${#current} > pad ? ${#current} : pad )); done
local -a entries
for line in "${labels[@]}"; do
  current=${line%%$'\t'*}
  entries+=("$current"$'\t'"${(r:pad+2:)current}${line#*$'\t'}")
done

if [[ -z $topic && -t 0 && -t 1 ]] && (( ! plain )) && command -v fzf >/dev/null 2>&1; then
  local selection result=0 initial=pages preview
  local -a query_option=() menu
  [[ -z $query ]] || query_option=("--query=$query") initial=entries
  # The picker reads its two views and each page's preview from a shelf of
  # files: the pages until a search starts, then every entry
  zmodload -F zsh/files b:zf_mkdir b:zf_rm
  local shelf=${TMPDIR:-/tmp}/keys.$$.$RANDOM
  zf_mkdir -m 700 "$shelf" || return
  {
    for current in "${topics[@]}"; do
      print -r -- "$pages[$current]" > "$shelf/$current.md"
      menu+=("$current"$'\t'"${(r:pad+2:)current}$titles[$current]")
    done
    print -r -- "$intro" > "$shelf/all.md"
    print -rl -- "${menu[@]}" > "$shelf/pages"
    print -rl -- "${entries[@]}" > "$shelf/entries"
    preview='cat "$KEYS_SHELF"/{1}.md'
    command -v glow >/dev/null 2>&1 &&
      preview='glow --style "$KEYS_STYLE" --width "$FZF_PREVIEW_COLUMNS" "$KEYS_SHELF"/{1}.md'
    # Only the repository's fzf options (colors and preview keys); personal ones could reshape the picker.
    # The preview sits beside the list from 110 columns (its threshold measures
    # the preview), and the wrap key shows beside the count once results do.
    selection=$(KEYS_SHELF=$shelf KEYS_STYLE=$repo/glow/guide.json \
      FZF_DEFAULT_OPTS= FZF_DEFAULT_OPTS_FILE=$repo/fzf/fzfrc \
      fzf --layout=reverse --no-multi --wrap --delimiter=$'\t' --with-nth=2.. $query_option \
        --bind='change:reload:[ -z {q} ] && cat "$KEYS_SHELF/pages" || cat "$KEYS_SHELF/entries"' \
        --bind='ctrl-/:toggle-wrap,alt-/:toggle-wrap' \
        --info-command='echo "$FZF_INFO${FZF_QUERY:+ · Ctrl+/ toggles wrapping}"' \
        --preview=$preview --preview-window='right,50%,wrap,<55(down,50%,wrap)' \
        --prompt='Find a task > ' \
        --header=$'Pick a page, or type to search every line\nEnter reads the page. Esc returns to the shell.' \
        < "$shelf/$initial") || result=$?
  } always {
    zf_rm -rf -- "$shelf"
  }
  case $result in
    0) topic=${selection%%$'\t'*} ;;
    1|130) return 0 ;;
    *) return $result ;;
  esac
elif [[ -n $query ]]; then
  # Without the picker, print the entries that hold every word.
  setopt local_options extended_glob
  local word
  local -a found=("${entries[@]}")
  for word in ${=query}; do found=(${(M)found:#(#i)*${word}*}); done
  (( $#found )) || { print -ru2 -- "keys: nothing matches '$query'; run keys --help for the topics"; return 1 }
  print -rl -- "${found[@]#*$'\t'}"
  return 0
fi

case $topic in
  '') content=$index ;;
  all)
    content=$intro
    for current in "${topics[@]}"; do content+=$'\n'"$pages[$current]"; done ;;
  *)
    [[ -n ${pages[$topic]-} ]] || { print -ru2 -- "keys: unknown topic '$topic'; run keys --help"; return 1 }
    content=$pages[$topic] ;;
esac
content+=$'\n---\n`Option+b` is a left-Option chord; `Space t m` is typed in Neovim normal mode. `keys` picks another task'

local reader=0
if (( ! plain )) && [[ -t 1 ]] && command -v glow >/dev/null 2>&1 && command -v less >/dev/null 2>&1; then
  reader=1
  content+='; `q` leaves the reader'
fi
content+=$'.\n'

if (( reader )); then
  local width=$(( COLUMNS > 0 && COLUMNS < 80 ? COLUMNS : 80 ))
  print -r -- "$content" | PAGER='less -R' LESS=-R glow --style "$repo/glow/guide.json" --width "$width" --pager -
else
  print -r -- "$content"
fi
