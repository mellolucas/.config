# vim: ft=zsh

emulate -L zsh

local target=${${1:-$PWD}:A}
[[ -e $target ]] || {
  print -u2 -- "github-open: no such path: ${1:-$PWD}"
  return 1
}

local dir=$target
[[ -d $dir ]] || dir=${dir:h}

# ref: current branch, short commit when detached, empty when unborn
local ref root rel
if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  if git -C "$dir" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    ref=$(git -C "$dir" symbolic-ref --short -q HEAD) ||
      ref=$(git -C "$dir" rev-parse --short HEAD)
  fi
  root=${$(git -C "$dir" rev-parse --show-toplevel):A}
  rel=${${target#"$root"}#/}
fi

# 1. Primary: gh browse (owner/repo from the remote); on failure the URL
#    fallback runs, and gh's diagnostics surface only if it also fails
local gh_err
if [[ -n $root ]] && command -v gh >/dev/null 2>&1; then
  local -a args
  [[ -n $ref && -n $rel ]] && args+=("$rel")
  [[ -n $ref ]] && args+=(--branch "$ref")
  gh_err=$( ( cd -q "$root" && gh browse "${args[@]}" ) 2>&1 ) && return 0
fi

# 2. Fallback: URL from the ~/code/<owner>/<repo> path convention
[[ $target == */code/* ]] || {
  [[ -n $gh_err ]] && print -r -u2 -- "github-open: gh: $gh_err"
  print -u2 -- "github-open: path is not within a '/code/' directory"
  return 1
}

local a b
IFS=/ read -r a b _ <<< "${target#*/code/}"

# Encode URL bytes, keeping separators only in the repository-relative path.
local LC_ALL=C
unsetopt multibyte
local part byte encoded escaped
local -a url_parts
for part in "$a" "$b" "$ref" "$rel"; do
  encoded=
  for byte in "${(@s::)part}"; do
    [[ -n $byte ]] || continue
    if [[ $byte == [a-zA-Z0-9.~_-] || ( $#url_parts == 3 && $byte == / ) ]]; then
      encoded+=$byte
    else
      printf -v escaped '%%%02X' "'$byte"
      encoded+=$escaped
    fi
  done
  url_parts+=("$encoded")
done
a=$url_parts[1] b=$url_parts[2] ref=$url_parts[3] rel=$url_parts[4]
local url="https://github.com/$a${b:+/$b}"
if [[ -n $ref ]]; then
  if [[ -f $target ]]; then
    url+="/blob/$ref/$rel"
  else
    url+="/tree/$ref${rel:+/$rel}"
  fi
fi

if [[ $OSTYPE == darwin* ]]; then
  open "$url"
  return $?
fi

if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$url" >/dev/null 2>&1
  return $?
fi

# Failure: exhausted all options
print -u2 -- "github-open: no suitable web browser launcher found"
return 1
