# vim: ft=zsh

emulate -L zsh

if (( ${argv[(I)(-h|--help)]} )); then
  print -r -- 'usage: github-open [PATH]'
  print -r -- 'Open PATH (default: the current directory) on GitHub at the current branch.'
  return 0
fi

command -v gh >/dev/null 2>&1 || {
  print -u2 -- 'github-open: needs gh, the GitHub CLI; run: dotfiles bundle'
  return 1
}

local target=${${1:-$PWD}:A}
[[ -e $target ]] || {
  print -u2 -- "github-open: no such path: ${1:-$PWD}"
  return 1
}

local dir=$target
[[ -d $dir ]] || dir=${dir:h}
local root
root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || {
  print -u2 -- "github-open: not in a Git repository: ${1:-$PWD}"
  return 1
}
root=${root:A}

# The current branch, or the commit when detached; an unborn branch opens the
# repository's home
local ref rel=${${target#"$root"}#/}
local -a args
if git -C "$dir" rev-parse -q --verify HEAD >/dev/null 2>&1; then
  ref=$(git -C "$dir" symbolic-ref --short -q HEAD) ||
    ref=$(git -C "$dir" rev-parse --short HEAD)
  [[ -n $rel ]] && args+=("$rel")
  args+=(--branch "$ref")
fi
( cd -q "$root" && gh browse "${args[@]}" )
