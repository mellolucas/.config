# vim: ft=zsh

emulate -L zsh

local -i show_code=0
local option
for option in "$@"; do
  case $option in
    --code) show_code=1 ;;
    -h|--help)
      print -r -- 'usage: git-glance [--code]'
      print -r -- 'Print a repository card; --code appends an eza language summary of its root.'
      return 0 ;;
    *) print -r -u2 -- "git-glance: unknown argument: $option"; return 1 ;;
  esac
done

zmodload -F zsh/stat b:zstat
zmodload -F zsh/datetime p:EPOCHSECONDS

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  print -u2 -- 'git-glance: not inside a git repository'
  return 1
}

local gitdir commondir toplevel branch
gitdir=$(git rev-parse --absolute-git-dir)
commondir=$(git rev-parse --path-format=absolute --git-common-dir)
toplevel=$(git rev-parse --show-toplevel)
branch=$(git symbolic-ref --short -q HEAD) ||
  branch="detached @ $(git rev-parse --short HEAD 2>/dev/null || print -- unborn)"

# Sync with upstream (counts only as fresh as the last fetch)
local upstream ahead='' behind=''
local -a lr
if upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then
  lr=($(git rev-list --left-right --count '@{upstream}...@' 2>/dev/null))
  (( ${lr[2]:-0} )) && ahead=" ↑${lr[2]}"  # Outgoing commits
  (( ${lr[1]:-0} )) && behind=" ↓${lr[1]}" # Incoming commits
else
  upstream=''
fi

local fetched='never fetched'
local -a heads mtimes
# Each worktree keeps the FETCH_HEAD of its own fetches; the newest counts
heads=($commondir/FETCH_HEAD(N.) $commondir/worktrees/*/FETCH_HEAD(N.))
if (( $#heads )) && zstat -A mtimes +mtime -- $heads 2>/dev/null; then
  mtimes=(${(On)mtimes})
  local -i age=$(( EPOCHSECONDS - mtimes[1] ))
  if   (( age < 3600 ));  then fetched="fetched $(( age / 60 ))m ago"
  elif (( age < 86400 )); then fetched="fetched $(( age / 3600 ))h ago"
  else                         fetched="fetched $(( age / 86400 ))d ago"
  fi
fi

# Operation left unfinished (finish or abort it before anything else)
local op=''
[[ -d $gitdir/rebase-merge || -d $gitdir/rebase-apply ]] && op='rebase'
[[ -f $gitdir/MERGE_HEAD ]]       && op='merge'
[[ -f $gitdir/CHERRY_PICK_HEAD ]] && op='cherry-pick'
[[ -f $gitdir/REVERT_HEAD ]]      && op='revert'
[[ -f $gitdir/BISECT_LOG ]]       && op='bisect'

# Worktree state
local line
local -i staged=0 modified=0 untracked=0 conflicted=0
git --no-optional-locks status --porcelain | while IFS= read -r line; do
  case ${line[1,2]} in
    ('??')        (( ++untracked ))  ;;
    (DD|AA|U?|?U) (( ++conflicted )) ;;
    (*) [[ ${line[1]} != ' ' ]] && (( ++staged ))
        [[ ${line[2]} != ' ' ]] && (( ++modified )) ;;
  esac
done

local -a wt
(( conflicted )) && wt+=("%F{red}${conflicted} conflicted%f")
(( staged ))     && wt+=("%F{green}${staged} staged%f")
(( modified ))   && wt+=("%F{blue}${modified} modified%f")
(( untracked ))  && wt+=("${untracked} untracked")
(( $#wt ))       || wt=('%F{green}clean%f')

local -a stashes others tasks
stashes=(${(f)"$(git stash list --format='%gs')"})
others=(${(f)"$(git for-each-ref refs/heads --count=6 --sort=-committerdate --format='%(refname:short)')"})
others=(${others:#$branch})
# Tasks with a worktree (workspace --task), but this one and those whose
# folder is gone
for line in ${(f)"$(git for-each-ref --format='%(if)%(worktreepath)%(then)%(refname:strip=3)%09%(worktreepath)%(end)' refs/heads/task/)"}; do
  [[ ! -d ${line#*$'\t'} ]] || tasks+=("${line%%$'\t'*}")
done
[[ $branch != task/* ]] || tasks=(${tasks:#${branch#task/}})

# The card fits the window, 40 to 100 columns wide (80 without one): truncate
# visible text first, %-escape after, so prompt escapes stay zero-width and no
# printed line exceeds the width. Text is measured in the cells it takes,
# two for most CJK characters
local -i width=${COLUMNS:-0}
(( width > 0 )) || width=80
(( width >= 40 )) || width=40
(( width <= 100 )) || width=100
# Cuts the text in the variable named $1 to $2 cells, ending it with …
_git-glance-fit() {
  local text=${(P)1}
  (( ${(m)#text} > $2 )) || return 0
  text=${text[1,$2 - 1]}
  while (( ${(m)#text} > $2 - 1 )); do text=${text[1,-2]}; done
  : ${(P)1::=$text…}
}
local repo=${toplevel:h:t}/${toplevel:t}
_git-glance-fit repo $(( width - 20 ))

# The branch row keeps its ↑/↓ counts: the upstream gives way first, down to
# 8 columns, then the branch
local -i room=$(( width - 13 - ${(m)#ahead} - ${(m)#behind} ))
local -i keep=$(( room - ${(m)#branch} ))
(( keep >= 8 )) || keep=8
_git-glance-fit upstream $keep
keep=$(( room - ${(m)#${upstream:-no upstream}} ))
(( keep >= 1 )) || keep=1
_git-glance-fit branch $keep
local track="→ ${${upstream:-no upstream}//\%/%%}"
[[ -z $ahead ]]  || track+="%F{green}$ahead%f"
[[ -z $behind ]] || track+="%F{red}$behind%f"

# The worktree row wraps under its values rather than running past the width
local worktree='' item plain
local -i column=0
for item in $wt; do
  plain=${${item#\%F\{*\}}%\%f}
  if (( column && 10 + column + 3 + ${#plain} > width )); then
    worktree+=$'\n'${(l:10:):-}
    column=0
  elif (( column )); then
    worktree+=' · '
    (( column += 3 ))
  fi
  worktree+=$item
  (( column += ${#plain} ))
done

local stash=${stashes[1]:-} nstash=$#stashes
_git-glance-fit stash $(( width - 13 - $#nstash ))

# The branches and tasks rows: names cut to 30 columns, as many as fit
local list name
local -a shown
local -A rows
local -i used
others=($others[1,4])
for list in others tasks; do
  shown=() used=0
  for name in ${(P)list}; do
    _git-glance-fit name 30
    (( used += ${(m)#name} + (used ? 3 : 0) ))
    (( used > width - 10 )) && break
    shown+=("${name//\%/%%}")
  done
  rows[$list]=${(j: · :)shown}
done

local -i pad=$(( width - ${(m)#repo} - ${#fetched} ))
# Push earlier output into scrollback; captured cards must not control the terminal.
if [[ $ZSH_SUBSHELL == 0 && -t 1 ]] && (( ${+commands[tput]} )); then
  local canvas_rows canvas_home
  if canvas_rows=$(command tput lines 2>/dev/null) &&
    [[ $canvas_rows == <-> ]] && (( canvas_rows > 0 )) &&
    canvas_home=$(command tput cup 0 0 2>/dev/null); then
    printf '\n%.0s' {1..$canvas_rows}
    print -rn -- "$canvas_home"
  fi
fi
print -rP -- $'\n'"%F{blue}${repo//\%/%%}%f${(l:pad:):-}${fetched}"
print -rP -- "%F{8}${(l:width::─:):-}%f"
[[ -n $op ]] && print -rP -- "%F{red}⚠ $op in progress%f"
print -rP -- "branch    %F{cyan}${branch//\%/%%}%f $track"
print -rP -- "worktree  $worktree"
(( nstash ))    && print -rP -- "stash     $nstash · ${stash//\%/%%}"
[[ -n $rows[others] ]] && print -rP -- "branches  $rows[others]"
[[ -n $rows[tasks] ]]  && print -rP -- "tasks     $rows[tasks]"
# Recent commits: the subject gives way first, then the author, then the age
if git rev-parse -q --verify HEAD >/dev/null 2>&1; then
  print
  local hash subject when who tail
  git --no-pager log -3 --no-show-signature --format='%h%x1f%s%x1f%ar%x1f%aN' |
    while IFS=$'\x1f' read -r hash subject when who; do
      tail=" · $when by $who"
      (( ${#hash} + 21 + ${(m)#tail} <= width )) || tail=" · $when"
      room=$(( width - ${#hash} - 1 - ${(m)#tail} ))
      (( room >= 10 )) || { tail=''; room=$(( width - ${#hash} - 1 )) }
      _git-glance-fit subject $room
      print -rP -- "%F{yellow}$hash%f ${subject//\%/%%}%F{8}${tail//\%/%%}%f"
    done
fi
print

if (( show_code )); then
  if (( ${+commands[eza]} )); then
    command eza --code=both -- "$toplevel"
  else
    print -u2 -- 'git-glance: eza unavailable; code summary skipped'
  fi
fi
