#compdef dotfiles

if (( CURRENT == 2 )); then
  local -a subcommands=(
    'install:Link configs, ensure Homebrew, and apply the Brewfile'
    'update:Fast-forward the repository, relink, and apply the Brewfile'
    'bundle:Apply the Brewfile, then update its npm packages'
    'link:Relink configs without touching packages'
    'doctor:Check the setup and name fixes'
    'uninstall:Remove the symlinks this repository owns'
    'help:Show help'
  )
  _describe command subcommands
elif [[ $words[2] == update ]]; then
  local -a words=("${words[@]:1}")
  local CURRENT=$(( CURRENT - 1 ))
  _arguments \
    '--discard[review and discard local changes before updating]' \
    '(--yes -y)'{--yes,-y}'[skip discard confirmation]' \
    '(--help -h)'{--help,-h}'[show help]'
fi
