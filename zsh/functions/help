# vim: ft=zsh

emulate -L zsh
zmodload -F zsh/parameter p:aliases p:builtins

(( $# )) || { print -u2 'usage: help COMMAND [ARGS...]  (run keys for what this setup adds)'; return 1 }
if [[ $1 == (-h|--help) ]]; then
  print -r -- 'usage: help COMMAND [ARGS...]'
  print -r -- "Show COMMAND's --help, following aliases to the real command, or its manual"
  print -r -- 'when it has no --help. Run keys for what this setup adds.'
  return 0
fi

# Accept literal words, quotes, escaped characters, and Git's @{...} revisions
# (no comma or .., so never brace expansion), not shell expressions.
local -a cmd=("$1")
local -A seen
local expression token previous
local -i editor_alias=0
local literal_word='^([a-zA-Z0-9_./:@%+,=!-]+|@\{[a-zA-Z0-9_-]+\}|\\.|'"'[^']*'"'|"[^"$`\\]*")+$'
local -a words
while (( ${+aliases[$cmd[1]]} )); do
  if (( ${+seen[$cmd[1]]} )); then
    print -u2 -- "help: alias cycle; ask for help on the underlying command"
    return 1
  fi
  seen[$cmd[1]]=1
  expression=$aliases[$cmd[1]]
  previous=$cmd[1]
  case $expression in
    '"${(@Q)${(z)EDITOR}}"'|'"${(@Q)${(z)EDITOR}}" -R -M')
      editor_alias=1
      words=("${(@Q)${(z)EDITOR}}")
      [[ -n $words[1] ]] || { print -u2 'help: EDITOR must name a command; ask for help on the underlying command'; return 1 }
      [[ $expression != *' -R -M' ]] || words+=(-R -M)
      ;;
    *)
      words=("${(@z)expression}")
      for token in "${words[@]}"; do
        if ! [[ $token =~ $literal_word ]]; then
          print -u2 -- "help: unsupported alias '$previous'; ask for help on the underlying command"
          return 1
        fi
      done
      words=("${(@Q)words}")
      ;;
  esac
  if [[ -z $words[1] || $words[1] == *=* ]]; then
    print -u2 -- "help: unsupported alias '$previous'; ask for help on the underlying command"
    return 1
  fi
  cmd=("${words[@]}" "${(@)cmd[2,-1]}")
  (( ! editor_alias )) || break
  [[ $cmd[1] != $previous ]] || break
done

# An alias shows what it runs first
(( ! ${+aliases[$1]} )) || print -r -- "$1 → ${(j: :)${(@q-)cmd}}"

if (( ${+builtins[$cmd[1]]} )); then
  if [[ ! -o interactive ]]; then
    man zshbuiltins
    return $?
  fi
  # Native run-help inspects aliases too; give it only the resolved command.
  (
    unalias -m '*'
    autoload -Uz run-help
    run-help "$cmd[1]"
  )
  return $?
fi

local -a request=("${cmd[@]}" "${@[2,-1]}")
# Git opens a subcommand's manual only for `git SUBCOMMAND --help`; options or
# revisions in between get a usage error instead (gdo, gdf).
[[ $request[1] == git && $request[2] == [^-]* ]] && request=(git "$request[2]")
local output result=0
output=$("${request[@]}" --help 2>&1) || result=$?
# BSD tools such as caffeinate reject --help; their manual is the help.
if (( result )) && man -w "$cmd[1]" >/dev/null 2>&1; then
  man "$cmd[1]"
  return $?
fi
if command -v bat >/dev/null 2>&1; then
  bat --plain --language=help <<< "$output" || :
elif [[ -n $output ]]; then
  print -r -- "$output"
fi
return $result
